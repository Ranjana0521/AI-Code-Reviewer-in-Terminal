# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openai | ollama
MODEL_PROVIDER=openai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Langfuse Observability ────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
# Set to false to disable tracing
LANGFUSE_ENABLED=true

# ── ChromaDB / RAG ────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=.chroma_db
CHROMA_COLLECTION_NAME=repo_codebase

# ── CLI Behaviour ─────────────────────────────────────────────────────────────
# Number of diff lines sent to LLM (0 = unlimited)
MAX_DIFF_LINES=500
# Stream responses to terminal
STREAM_RESPONSES=true
# Cache LLM responses on disk
CACHE_ENABLED=true
CACHE_DIR=.cache
